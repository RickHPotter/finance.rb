<% failure_notifications_for(@entity, :not_updateda, Entity).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(@entity, Views::Entities::Form.new(current_user:, entity: @entity, return_to: @return_to)) %>
