<% failure_notifications_for(@user_card, :not_created, UserCard).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(
      @user_card,
      Views::UserCards::Form.new(
        current_user:,
        user_card: @user_card,
        cards: @cards,
        return_to: @return_to
      )
    ) %>
