<% failure_notifications_for(@user_bank_account, :not_updateda, UserBankAccount).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(
      @user_bank_account,
      Views::UserBankAccounts::Form.new(
        current_user:,
        user_bank_account: @user_bank_account,
        banks: @banks,
        return_to: @return_to
      )
    ) %>
