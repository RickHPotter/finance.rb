<% failure_notifications_for(@investment, :not_created, Investment).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(
      @investment,
      Views::Investments::Form.new(current_user:, investment: @investment, chain_context: @chain_context, return_to: @return_to)
    ) %>
