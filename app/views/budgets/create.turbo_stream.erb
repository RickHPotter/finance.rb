<% failure_notifications_for(@budget, :not_created, Budget).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(@budget, Views::Budgets::Form.new(current_user:, budget: @budget, return_to: @return_to)) %>
