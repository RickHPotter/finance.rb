<% failure_notifications_for(@category, :not_updateda, Category).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(@category, Views::Categories::Form.new(current_user:, category: @category, return_to: @return_to)) %>
