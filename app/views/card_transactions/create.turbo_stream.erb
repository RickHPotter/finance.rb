<% failure_notifications_for(@card_transaction, :not_createda, CardTransaction).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(
      @card_transaction,
      Views::CardTransactions::Form.new(
        current_user:,
        card_transaction: @card_transaction,
        chain_context: @chain_context,
        return_to: @return_to
      )
    ) %>
