<% failure_notifications_for(@subscription, :not_updated, Subscription).each_with_index do |alert, index| %>
  <%= turbo_stream.public_send(index.zero? ? :update : :append, :notification, partial: "shared/flash", locals: { notice: nil, alert: }) %>
<% end %>

<%= turbo_stream.replace(@subscription, Views::Subscriptions::Form.new(current_user:, subscription: @subscription, return_to: @return_to)) %>
